<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="MedievalOverhaulRoyalty.PatchOperation_ToggleSettings">
		<settings>
			<li>EEG_RoyaltyTrader</li>
		</settings>
		<!-- ACTIVE: Empire Trader komplett zu Medieval konvertiert -->
