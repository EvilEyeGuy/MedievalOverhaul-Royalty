<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="MedievalOverhaulRoyalty.PatchOperation_ToggleSettings">
		<settings>
			<li>EEG_MedievalUnits</li>
		</settings>
		<defaultOn>true</defaultOn>
		<active Class="PatchOperationConditional">
			<xpath>Defs/FactionDef[defName="Empire"]/pawnGroupMakers/li/options/Accurex_Medieval_Empire_Mercenary</xpath>
			<match Class="PatchOperationAdd">
				<xpath>Defs/FactionDef[defName="Empire"]/pawnGroupMakers</xpath>
				<value>
					<li>
						<kindDef>Combat</kindDef>
						<commonality>12</commonality>
						<options>
							<Accurex_Medieval_Empire_Crusader_Mounted>1</Accurex_Medieval_Empire_Crusader_Mounted>
						</options>
					</li>
				</value>
			</match>
		</active>
	</Operation>

</Patch>
